{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "platform": {
    "apiRuntime": "node:20"
  },
  "trailingSlash": "always",
  "routes": [
    { "route": "/index.html", "redirect": "/", "statusCode": 301 },
    { "route": "/Oferta.dc.html", "redirect": "/oferta/", "statusCode": 301 },
    { "route": "/Adopcion.dc.html", "redirect": "/adopcion-garantizada/", "statusCode": 301 },
    { "route": "/Nosotros.dc.html", "redirect": "/nosotros/", "statusCode": 301 },
    { "route": "/Recursos.dc.html", "redirect": "/recursos/", "statusCode": 301 },
    { "route": "/Contacto.dc.html", "redirect": "/contacto/", "statusCode": 301 },
    {
      "route": "/api/contacto",
      "methods": ["POST"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/health",
      "methods": ["GET"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/*",
      "statusCode": 404
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "SAMEORIGIN"
  },
  "mimeTypes": {
    ".webp": "image/webp"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  }
}
